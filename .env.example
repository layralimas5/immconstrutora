# Medição do site. Copie para .env.local no desenvolvimento e cadastre as
# mesmas chaves na Vercel em Settings > Environment Variables.
# Sem estas variáveis o site funciona igual, apenas não envia nada.

# Google Analytics 4 — responde "quantos acessaram e até onde foram"
VITE_GA4_ID=

# Google Ads — conta de conversão
VITE_ADS_ID=

# Label da conversão "Orçamento enviado pelo formulário" (conversão principal)
VITE_ADS_LEAD_LABEL=

# Label da conversão "Clique no WhatsApp" (conversão secundária)
VITE_ADS_WHATSAPP_LABEL=
